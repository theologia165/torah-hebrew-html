{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/asaichi-torah/current.schema.json",
  "title": "Asaichi Torah Ver.2 Work Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "sequence", "passage", "verses"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "date": {"type": "string", "format": "date"},
    "sequence": {"type": "string", "pattern": "^[0-9]{3}$"},
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "chapter", "start_verse", "end_verse", "display"],
      "properties": {
        "book": {"type": "string", "minLength": 1},
        "chapter": {"type": "integer", "minimum": 1},
        "start_verse": {"type": "integer", "minimum": 1},
        "end_verse": {"type": "integer", "minimum": 1},
        "display": {"type": "string", "minLength": 1}
      }
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verse", "hebrew", "translation", "words", "short_commentary"],
        "properties": {
          "verse": {"type": "integer", "minimum": 1},
          "hebrew": {"type": "string", "minLength": 1},
          "translation": {"type": "string", "minLength": 1},
          "short_commentary": {"type": "string", "minLength": 1},
          "detailed_commentary": {"type": "string"},
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["surface", "separator_after", "gloss", "lemma", "pos", "morph", "morph_code"],
              "properties": {
                "surface": {"type": "string", "minLength": 1},
                "separator_after": {"type": "string", "pattern": "^[ ־׃׀]*$"},
                "gloss": {"type": "string", "minLength": 1},
                "lemma": {"type": "string", "minLength": 1},
                "pos": {"type": "string", "minLength": 1},
                "morph": {"type": "string", "minLength": 1},
                "morph_code": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "summary": {"type": "string"},
    "modern_connection": {"type": "string"},
    "interpretive_cautions": {"type": "string"},
    "callout2": {"type": "string"},
    "radio_script": {"type": "string"}
  }
}
